# Copy to .env and adjust. Do not commit real secrets.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me
APP_BASE_URL=http://127.0.0.1:8000
WEBSITE_BASE_URL=http://127.0.0.1:8001

# Use 127.0.0.1 instead of localhost so MySQL resolves over IPv4 (some VPNs break localhost/IPv6).
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/fireguard?serverVersion=8.0"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me

CORS_ALLOW_ORIGIN='*'
